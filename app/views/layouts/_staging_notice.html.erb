<%# A staging tells its visitors it is not the real web (STAGING_NOTICE). %>
<% if ENV['STAGING_NOTICE'].present? %>
  <aside id="staging-notice" aria-label="Testovacie prostredie" style="background: #fde047; color: #030712;">
    <div aria-hidden="true" style="height: 8px; background: repeating-linear-gradient(-45deg, #030712 0 10px, #fde047 10px 20px);"></div>
    <div class="container" style="display: flex; gap: 12px; align-items: flex-start; padding-top: 12px; padding-bottom: 12px; font-size: 14px; line-height: 1.5;">
      <svg aria-hidden="true" width="20" height="20" style="flex-shrink: 0; margin-top: 1px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
      <p style="margin: 0;">
        <strong>Toto je testovacie prostredie webu Ekosystému, nie ostrá verzia.</strong>
        <%= ENV['STAGING_NOTICE'] %>
        Ostrý web nájdete na <a href="https://ekosystem.slovensko.digital" style="color: #030712; font-weight: 600; text-decoration: underline;">ekosystem.slovensko.digital</a>.
      </p>
    </div>
  </aside>
<% end %>
